generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum AdminRole {
  SUPER_ADMIN
  STAFF
}

enum RoastLevel {
  LIGHT
  MEDIUM
  DARK
}

enum FulfillmentStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  COD
  MANUAL_TRANSFER
  MFS
}

enum PaymentStatus {
  PENDING_VERIFICATION
  VERIFIED
  PAID
  REJECTED
  REFUNDED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum InquiryType {
  SUPPORT
  WHOLESALE
}

enum InquiryStatus {
  NEW
  REPLIED
  ARCHIVED
}

model AdminUser {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         AdminRole @default(STAFF)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  verifiedPayments Payment[]      @relation("PaymentVerifier")
  inventoryLogs    InventoryLog[]
}

model Category {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  imageUrl  String?
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  products Product[]

  @@index([isActive, sortOrder])
}

model Product {
  id           String      @id @default(cuid())
  categoryId   String
  name         String
  slug         String      @unique
  description  String      @db.Text
  roastLevel   RoastLevel?
  originNotes  String?
  basePrice    Decimal     @db.Decimal(10, 2)
  comparePrice Decimal?    @db.Decimal(10, 2)
  images       String[]
  isActive     Boolean     @default(true)
  isFeatured   Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  category   Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants   ProductVariant[]
  orderItems OrderItem[]
  reviews    ProductReview[]

  @@index([categoryId, isActive])
  @@index([isFeatured, isActive])
  @@index([roastLevel])
}

model ProductVariant {
  id            String   @id @default(cuid())
  productId     String
  name          String
  sku           String   @unique
  priceOverride Decimal? @db.Decimal(10, 2)
  stockCount    Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  product       Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems    OrderItem[]
  inventoryLogs InventoryLog[]

  @@index([productId, isActive])
  @@index([stockCount])
}

model InventoryLog {
  id            String   @id @default(cuid())
  variantId     String
  quantityDelta Int
  previousStock Int
  newStock      Int
  reason        String
  adminId       String?
  createdAt     DateTime @default(now())

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  admin   AdminUser?     @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([variantId, createdAt])
}

model Order {
  id                String            @id @default(cuid())
  orderRef          String            @unique
  customerName      String
  customerPhone     String
  customerEmail     String?
  city              String
  address           String            @db.Text
  notes             String?           @db.Text
  internalNotes     String?           @db.Text
  subtotal          Decimal           @db.Decimal(10, 2)
  discountAmount    Decimal           @default(0) @db.Decimal(10, 2)
  promoCodeUsed     String?
  deliveryFee       Decimal           @default(0) @db.Decimal(10, 2)
  totalAmount       Decimal           @db.Decimal(10, 2)
  fulfillmentStatus FulfillmentStatus @default(PENDING)
  stockRestored     Boolean           @default(false)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  items   OrderItem[]
  payment Payment?

  @@index([orderRef, customerPhone])
  @@index([fulfillmentStatus, createdAt])
}

model OrderItem {
  id                  String  @id @default(cuid())
  orderId             String
  productId           String
  variantId           String
  productNameSnapshot String
  variantSnapshot     String
  skuSnapshot         String
  unitPriceSnapshot   Decimal @db.Decimal(10, 2)
  quantity            Int

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([orderId])
}

model Payment {
  id            String        @id @default(cuid())
  orderId       String        @unique
  method        PaymentMethod
  status        PaymentStatus @default(PENDING_VERIFICATION)
  amount        Decimal       @db.Decimal(10, 2)
  trxId         String?
  senderAccount String?
  verifiedById  String?
  auditNote     String?       @db.Text
  verifiedAt    DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  order      Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  verifiedBy AdminUser? @relation("PaymentVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([trxId])
}

model PromoCode {
  id             String       @id @default(cuid())
  code           String       @unique
  discountType   DiscountType
  discountValue  Decimal      @db.Decimal(10, 2)
  minOrderAmount Decimal      @default(0) @db.Decimal(10, 2)
  maxUses        Int?
  usedCount      Int          @default(0)
  expiresAt      DateTime?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([code, isActive])
}

model ProductReview {
  id                 String       @id @default(cuid())
  productId          String
  authorName         String
  rating             Int
  comment            String       @db.Text
  isVerifiedPurchase Boolean      @default(false)
  status             ReviewStatus @default(PENDING)
  isFeatured         Boolean      @default(false)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, status])
  @@index([isFeatured, status])
}

model NewsletterSubscriber {
  id           String   @id @default(cuid())
  email        String   @unique
  source       String   @default("homepage_footer")
  subscribedAt DateTime @default(now())
}

model SupportInquiry {
  id          String        @id @default(cuid())
  name        String
  email       String
  phone       String?
  inquiryType InquiryType   @default(SUPPORT)
  message     String        @db.Text
  status      InquiryStatus @default(NEW)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, createdAt])
}

model StoreSettings {
  id                    String   @id @default("default")
  storeName             String   @default("Rostvyn")
  currencyCode          String   @default("USD")
  freeShippingThreshold Decimal  @default(45.00) @db.Decimal(10, 2)
  contactPhone          String?
  contactEmail          String?
  address               String?  @db.Text
  metroDeliveryFee      Decimal  @default(5.00) @db.Decimal(10, 2)
  nationalDeliveryFee   Decimal  @default(12.00) @db.Decimal(10, 2)
  paymentAccounts       Json?
  announcementText      String?  @default("Free Delivery on Orders Over $45 • Roasted Every Tuesday & Friday")
  heroData              Json?
  storyData             Json?
  policyTexts           Json?
  updatedAt             DateTime @updatedAt
}
