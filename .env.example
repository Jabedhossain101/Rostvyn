# NeonDB PostgreSQL (Pooled connection string for application queries)
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-your-endpoint-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# NeonDB PostgreSQL (Direct connection string for Prisma migrations & schema push)
DIRECT_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-your-endpoint.us-east-2.aws.neon.tech/neondb?sslmode=require"

# 32+ character cryptographically random secret for jose HS256 JWT session signing
JWT_SECRET="replace-with-a-secure-random-string-at-least-32-characters-long"
